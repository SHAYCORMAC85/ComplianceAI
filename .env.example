# ==============================================================================
# AI Compliance Inspection Agent - Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# LLM Provider Configuration (Phase 2)
# Supported options: "openai" | "gemini" | "mock"
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_ID=gemini-3.5-flash
PROMPT_VERSION=v1.0

# LLM Execution Limits
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_REQUESTS_PER_MINUTE=4
LLM_RATE_LIMIT_SAFETY_BUFFER=2.0

# Processing & Chunking Configuration
CHUNK_MIN_CHARS=50
CHUNK_MAX_CHARS=2000

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

